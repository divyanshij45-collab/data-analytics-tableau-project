  <worksheets>
    <worksheet name=' 6 Volatility'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='9'>&quot;Price Volatility by Region (higher=riskier)&quot;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='global_fuel_prices_Dataset (1)' name='federated.0sz2bhv0eff9az1fovax71x52yf5' />
          </datasources>
          <datasource-dependencies datasource='federated.0sz2bhv0eff9az1fovax71x52yf5'>
            <column aggregation='Sum' caption='Year' datatype='integer' name='[Calculation_1060539279515649]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='YEAR([date])' />
            </column>
            <column caption='Price Volatility' datatype='real' name='[Calculation_1060539280130050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [country] : STDEV([petrol_usd_liter]) / AVG([petrol_usd_liter])})' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Income Level' datatype='string' name='[income_level]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1060539279515649]' derivation='None' name='[none:Calculation_1060539279515649:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
