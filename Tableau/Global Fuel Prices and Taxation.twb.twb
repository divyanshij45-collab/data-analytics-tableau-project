            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1060539280130050]' derivation='User' name='[usr:Calculation_1060539280130050:qk]' pivot='key' type='quantitative' />
